# Copy this file to .env and fill in real values.
# .env stays home, .env.example goes to GitHub.

# --- app ---
APP_PORT=3000
NODE_ENV=development

# --- database (PostgreSQL) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=alumni
DB_USER=alumni_user
DB_PASSWORD=change_me_in_your_own_env

# host port that maps to the database container (for DBeaver)
DB_PORT_HOST=5433
